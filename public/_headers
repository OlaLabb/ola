# Cloudflare Pages y Netlify leen este archivo desde la raiz del sitio.

# La imagen para redes ya es un .png de verdad, asi que el Content-Type lo pone
# el host. Solo la cacheamos.
/opengraph-image.png
  Cache-Control: public, max-age=3600

# Los archivos con hash en el nombre no cambian nunca: cache agresivo.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
